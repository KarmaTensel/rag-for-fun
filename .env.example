# LLM provider
# For OpenAI: set your real key and remove OPENAI_BASE_URL
# For Ollama: set OPENAI_API_KEY=ollama and point BASE_URL to Ollama
OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=http://localhost:11434/v1

# Single DB user — needs SELECT, INSERT, UPDATE, DELETE on the embeddings table
DATABASE_URL=postgresql://app_user:password@localhost:5432/yourdb

# Table name for embeddings (LlamaIndex adds "data_" prefix automatically)
EMBEDDINGS_TABLE=document_embeddings

# Chunking config
CHUNK_SIZE=512
CHUNK_OVERLAP=50

# LLM for answer generation
GPT_MODEL=gpt-4o-mini

# Embedding model & dimension (must match the model's output dimension)
# OpenAI: text-embedding-ada-002 (1536) | Ollama: nomic-embed-text (768)
EMBEDDING_MODEL=text-embedding-ada-002
EMBEDDING_DIM=1536

# Shared secret — set the same value in Rails as PYTHON_SERVICE_API_KEY
API_KEY=your-strong-random-secret-here
